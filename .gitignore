# Repo-root ignores: OS and editor noise only.
#
# Backend-specific rules (node_modules, .env, WhatsApp session data, logs)
# live in sandesha-server/.gitignore so they stay scoped to that folder and
# cannot accidentally exclude website assets such as assets/*.png.

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Local HTTPS cert for phone-on-LAN
.local-certs/

# Separate repo (backend); not part of the Pages site
sandesha-vjn/

# Per-machine overrides of config.js (e.g. point Sandesha at the laptop)
config.local.js
