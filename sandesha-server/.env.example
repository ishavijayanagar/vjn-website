# Sandesha environment variables
# Copy to .env and fill in values. Never commit .env to git.

# Required before exposing API via Cloudflare Tunnel (./start.sh starts a Quick Tunnel by default)
SANDESHA_ADMIN_PASSWORD=

# VJN website Apps Script URL — used by POST /auth/vjn-exchange to validate admin tokens
VJN_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Local dev only — disables API auth (do NOT use with tunnel/public access)
# SANDESHA_AUTH_DISABLED=1

# Optional — Puppeteer / Chromium (see RASPBERRY_PI_SETUP.md)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ---------------------------------------------------------------------------
# WhatsApp login: pairing code (instead of QR) + optional email
# ---------------------------------------------------------------------------
# Phone in international format, digits only (no + or spaces). Enables
# Linked devices → Link with phone number instead of scanning QR.
# When WhatsApp logs out, the dashboard shows this pairing code so you can
# reconnect without restarting the whole app.
# SANDESHA_PAIRING_PHONE=919876543210
# qr = scan QR (recommended). auto = try phone pairing, fall back to QR if broken.
# SANDESHA_AUTH_MODE=qr

# ---------------------------------------------------------------------------
# Public URL / tunnel mode
# ---------------------------------------------------------------------------
# funnel (recommended, no domain) = stable https://*.ts.net via Tailscale Funnel
# quick                           = Cloudflare Quick Tunnel (URL changes each restart)
# named                           = Cloudflare named tunnel (needs your domain)
SANDESHA_TUNNEL_MODE=funnel

# Only for named mode:
# SANDESHA_PUBLIC_URL=https://sandesha.yourdomain.com
# Also copy scripts/sandesha-named-tunnel.yml.example → sandesha-named-tunnel.yml

# Where to email pairing codes and the public dashboard URL on start
# SANDESHA_NOTIFY_EMAIL=you@example.com

# Optional: force Me Commands group JID if auto-detect by name fails
# SANDESHA_COMMANDS_GROUP_JID=120363...@g.us

# SMTP (Gmail: use an App Password, not your normal password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Sandesha <you@example.com>

# ---------------------------------------------------------------------------
# Sending safety — pacing, quiet hours and daily caps (SENDING_SAFETY.md)
# ---------------------------------------------------------------------------
# Every value below is a default already applied in code; uncomment to change.
# The gaps are deliberately wide: a flyer that lands across the centre's groups
# over ten minutes looks like a volunteer posting, one that lands in twenty
# seconds does not. Never set the minimum below ~5000.

# Gap between chats in a scheduled fan-out or a bulk send
# SANDESHA_SEND_JITTER_MIN_MS=45000
# SANDESHA_SEND_JITTER_MAX_MS=90000

# Gap when broadcasting to every group — the widest fan-out, so the slowest
# SANDESHA_BROADCAST_JITTER_MIN_MS=60000
# SANDESHA_BROADCAST_JITTER_MAX_MS=120000

# Gap between adding people to a group — the most heavily policed action
# SANDESHA_PARTICIPANT_JITTER_MIN_MS=75000
# SANDESHA_PARTICIPANT_JITTER_MAX_MS=150000

# Settling pause after an upload, before the media send itself
# SANDESHA_MEDIA_JITTER_MIN_MS=3000
# SANDESHA_MEDIA_JITTER_MAX_MS=5000

# Do-not-send window, IST. Schedules due inside it are HELD, never dropped.
# Set both to the same value to disable quiet hours.
# SANDESHA_QUIET_START_HOUR=22
# SANDESHA_QUIET_END_HOUR=8

# Ceilings, counted in state.json so a restart cannot hand out a fresh budget.
# 0 disables that ceiling.
# SANDESHA_MAX_SENDS_PER_HOUR=30
# SANDESHA_MAX_SENDS_PER_DAY=120

# Typing presence + think-time before a send (0 to disable)
# SANDESHA_TYPING_SIMULATION=1

# Vary the opener/closer when one message fans out to many chats (0 to disable).
# Presentation variety only — the message body is never altered.
# SANDESHA_CAPTION_VARIATION=1

# Append one line per send to send-audit.jsonl, to audit real intervals
# SANDESHA_SEND_AUDIT=1
